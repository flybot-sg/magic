<Project DefaultTargets="All">
    <PropertyGroup>
        <NostrandExeNet4x>nostrand/bin/Release/net471/NostrandMain.exe</NostrandExeNet4x>
        <MagicUnityMagicRuntimeDir>magic-unity/Runtime/magic</MagicUnityMagicRuntimeDir>
        <MagicUnityCompilerDir>magic-unity/Editor/Compiler</MagicUnityCompilerDir>
        <NostrandProject>nostrand/NostrandMain.csproj</NostrandProject>
        <ClojureRuntimeDllNet471>clojure-runtime/bin/Release/net471/Clojure.dll</ClojureRuntimeDllNet471>
        <ClojureRuntimeDllNetStandard>clojure-runtime/bin/Release/netstandard2.0/Clojure.dll</ClojureRuntimeDllNetStandard>
        <MagicRuntimeDllNet471>magic-runtime/Magic.Runtime/bin/Release/net471/Magic.Runtime.dll</MagicRuntimeDllNet471>
        <NostrandReferences>nostrand/references</NostrandReferences>
        <MagicBootstrap>magic-compiler/bootstrap</MagicBootstrap>
    </PropertyGroup>
    <ItemGroup>
        <!-- The bootstrap owns the partition: it writes each namespace into
             stdlib/ or compiler/. -->
        <MagicAllBinaries Include="$(MagicBootstrap)/*/*.clj.dll"/>
        <MagicRuntimeBinaries Include="$(MagicBootstrap)/stdlib/*.clj.dll" />
        <!-- Editor-only at run time: MSIL emission needs Reflection.Emit. -->
        <MagicCompilerBinaries Include="$(MagicBootstrap)/compiler/*.clj.dll" />
    </ItemGroup>

    <Target Name="All">
        <Exec Command="dotnet build -t:Clean" />
        <Exec Command="dotnet build -t:Magic" />
        <Exec Command="dotnet build -t:Bootstrap" />
        <Exec Command="dotnet build -t:MagicUnity" />
    </Target>

    <!-- Do not guard on Exists(): dotnet build is incremental by timestamp, and an
         existence check keeps a stale host after a C# edit. -->
    <Target Name="Nostrand">
        <Exec Command="dotnet build $(NostrandProject) -c Release" />
    </Target>
    <Target Name="Magic" DependsOnTargets="Nostrand" Condition="!Exists('$(MagicBootstrap)')">
        <Exec WorkingDirectory="magic-compiler" Command="mono ../$(NostrandExeNet4x) build/bootstrap" />
    </Target>
    <Target Name="MagicUnity" DependsOnTargets="Magic">
        <Copy SourceFiles="@(MagicRuntimeBinaries)" DestinationFolder="$(MagicUnityMagicRuntimeDir)" />
        <Copy SourceFiles="@(MagicCompilerBinaries)" DestinationFolder="$(MagicUnityCompilerDir)" />
        <Copy SourceFiles="$(ClojureRuntimeDllNet471)" DestinationFolder="$(MagicUnityMagicRuntimeDir)" />
        <Copy SourceFiles="$(MagicRuntimeDllNet471)" DestinationFolder="$(MagicUnityMagicRuntimeDir)" />
    </Target>
    <Target Name="Bootstrap" DependsOnTargets="Magic">
        <Copy SourceFiles="@(MagicAllBinaries)" DestinationFolder="$(NostrandReferences)" />
        <Exec Command="dotnet build $(NostrandProject) -c Release" />
    </Target>

    <Target Name="Clean">
        <RemoveDir Directories="clojure-runtime/bin;nostrand/bin;nostrand-lib/bin;magic-runtime/Magic.Runtime/bin;magic-runtime/Magic.Runtime.Callsites/bin;magic-compiler/bootstrap" />
    </Target>
</Project>
